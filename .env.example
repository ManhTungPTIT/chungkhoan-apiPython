# Copy thành .env (cạnh file này, NGOÀI git) rồi điền giá trị thật.
# envfile.load_dotenv nạp lúc khởi động, KHÔNG ghi đè env đã set sẵn.

# Tài khoản DNSE — stream tick realtime (dnse_stream.py). Thiếu thì app vẫn
# chạy, FE fallback poll /quotes.
DNSE_USER=
DNSE_PASSWORD=

# API key vnstock trả phí (vnstocks.com) — vnii xác thực tier lúc khởi động
# (Golden 500 req/phút). Thiếu/sai → chạy tier Community 60 req/phút.
VNSTOCK_API_KEY=

# Cố định device fingerprint cho vnai (đọc bởi Inspector.fingerprint(), ưu
# tiên cao nhất trước mọi cơ chế tự sinh khác). BẮT BUỘC trên môi trường
# container/CI: mỗi lần `docker run` tạo container mới, vnai tính fingerprint
# khác nhau (dựa network/hostname container, không phải phần cứng máy chủ) →
# mỗi lần redeploy tự đăng ký như 1 THIẾT BỊ MỚI, nhanh chóng hết quota thiết
# bị của tài khoản (lỗi "Không tìm thấy thông tin người dùng hợp lệ" hoặc từ
# chối đăng ký thiết bị). Đặt CỐ ĐỊNH 1 giá trị (uuid4 hex, tự sinh 1 lần) và
# KHÔNG đổi giữa các lần deploy để chỉ tốn đúng 1 slot thiết bị vĩnh viễn.
VNSTOCK_DEVICE_ID=
